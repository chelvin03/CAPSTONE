# INCOMPLETE TEMPLATE. Do not upload until the blank settings are filled privately.
# Copy your EXISTING APP_KEY from the selected source .env. Never generate another key.
APP_NAME="MCST Gymnasium"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=7

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# External SMTP supporting STARTTLS on port 587 is required for public verification
# and staff login. Blank host/auth/from fields must be filled before going live.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
GYM_LOCAL_TEST_ADMIN_PASSWORD_ONLY=false
GYM_LOCAL_TEST_STAFF_PASSWORD_ONLY=false

# Preserve any additional GYM_* business settings from the selected source .env.
# Do not run scheduled commands through public web endpoints.
